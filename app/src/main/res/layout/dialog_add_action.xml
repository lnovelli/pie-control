<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Action"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ================= PRIMARY ACTION CARD ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIMARY TRIGGER (Immediate Release)"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rgActionCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbSystem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="System"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="App"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbUrl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="URL"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbFolder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Folder"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- Primary System Container -->
            <LinearLayout
                android:id="@+id/layoutSystemActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/spinnerSystemActions"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <!-- Primary App Picker Container -->
            <LinearLayout
                android:id="@+id/layoutAppPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etSearchApp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_card"
                    android:hint="Search installed apps..."
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAppsList"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />
            </LinearLayout>

            <!-- Primary Web URL Container -->
            <LinearLayout
                android:id="@+id/layoutUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etWebUrl"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_card"
                    android:hint="https://example.com"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:inputType="textUri"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etWebLabel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_card"
                    android:hint="Shortcut Label (e.g. Website)"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Primary Folder Picker Container -->
            <LinearLayout
                android:id="@+id/layoutFolderPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/spinnerPrimaryFolder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ================= SECONDARY ACTION CARD ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SECONDARY TRIGGER (Hover / Hold)"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnableSecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSecondaryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <RadioGroup
                    android:id="@+id/rgSecondaryCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbSecSystem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="System"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rbSecApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="App"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rbSecUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="URL"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rbSecFolder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Folder"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:textColor="@color/text_primary" />
                </RadioGroup>

                <!-- Secondary System Container -->
                <LinearLayout
                    android:id="@+id/layoutSecSystemActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Spinner
                        android:id="@+id/spinnerSecSystemActions"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="12dp" />
                </LinearLayout>

                <!-- Secondary App Picker Container -->
                <LinearLayout
                    android:id="@+id/layoutSecAppPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etSecSearchApp"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_card"
                        android:hint="Search apps for secondary..."
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSecAppsList"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
                </LinearLayout>

                <!-- Secondary Web URL Container -->
                <LinearLayout
                    android:id="@+id/layoutSecUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etSecWebUrl"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_card"
                        android:hint="https://example.com"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:inputType="textUri"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etSecWebLabel"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_card"
                        android:hint="Shortcut Label (e.g. Website)"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:inputType="text" />
                </LinearLayout>

                <!-- Secondary Folder Picker Container -->
                <LinearLayout
                    android:id="@+id/layoutSecFolderPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spinnerSecFolder"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="12dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Compact Footer Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="16dp"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/btnDialogCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cancel"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDialogSave"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Save Action"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
