<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp">
        <ImageView
            android:id="@+id/ivActionIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="start|top"
            android:padding="4dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@drawable/ic_action_back"
            android:contentDescription="Action Icon" />
        <ImageView
            android:id="@+id/ivSecondaryIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="end|bottom"
            android:padding="2dp"
            android:visibility="gone"
            android:background="@drawable/bg_circle_icon"
            android:src="@drawable/ic_action_home"
            android:contentDescription="Secondary Action Icon" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActionSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Navigation"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteAction"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_delete"
        android:tint="@color/accent_red"
        android:contentDescription="Remove Action" />

</LinearLayout>
